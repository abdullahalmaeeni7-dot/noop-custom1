# Server only. Never copy credentials or encryption keys into the iOS target.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Public HTTPS origin with no path, query, fragment, or credentials.
# Register EXACTLY https://bridge.example.com/oauth/callback in WHOOP dashboard.
PUBLIC_ORIGIN=https://bridge.example.com
# Generate locally with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE_PATH=./data/sessions.enc
# Listen behind your HTTPS reverse proxy; never expose this plain HTTP listener.
HOST=127.0.0.1
PORT=8787

# Nutrition AI. Use a NEW key in the hosting provider's secret settings.
# Never copy provider keys into the iPhone app or repository.
AI_PROVIDER=gemini
AI_API_KEY=
AI_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-2.5-flash
# Nutrition-only mode: generate a private random access code of at least 32 characters.
# Store it on the server; pair your own phone using this separate code, not the Gemini key.
NUTRITION_ACCESS_TOKEN=
# Start nutrition-only mode with: node Server/nutrition-server.mjs
# Existing WHOOP account bridge remains: node Server/server.mjs
# For OpenAI: AI_PROVIDER=openai, AI_API_URL=https://api.openai.com/v1/chat/completions,
# AI_MODEL=gpt-4o-mini. WHOOP OAuth is not needed in nutrition-only mode.
